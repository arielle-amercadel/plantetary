# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in the Supabase Dashboard under Project Settings -> API Keys (and Data API for the URL).
#
# Both values are public: they're built into the browser app, and Row Level Security protects the data.
# Never put a secret key (sb_secret_...) or the service_role key here, or anywhere in the app.
# Plantetary refuses to turn on sign-in if it detects one.
#
# Leave both empty to run Plantetary without sign-in. Guest mode works exactly the same either way.
# Next.js builds these into the app, so restart `npm run dev` or rebuild after changing them.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
